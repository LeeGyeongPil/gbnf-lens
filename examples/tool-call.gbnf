# A small tool-call grammar: {"name": "...", "arguments": {...}}
root  ::= "{" ws "\"name\"" ws ":" ws name ws "," ws "\"arguments\"" ws ":" ws args ws "}"
name  ::= "\"get_weather\"" | "\"search\""
args  ::= "{" ws (pair ("," ws pair)*)? ws "}"
pair  ::= string ws ":" ws value
value ::= string | number | "true" | "false" | "null"
string ::= "\"" [^"\\]* "\""
number ::= "-"? [0-9]+ ("." [0-9]+)?
ws    ::= [ \t\n]*
